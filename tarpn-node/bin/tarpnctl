#!/bin/bash
# tarpnctl - manage a modular TARPN node.
#
# Replaces the parts of the legacy `tarpn` command that this installation
# still needs. Service control is delegated to systemd rather than
# reimplemented: there are no flag files, no semaphores and no killall.
#
#   tarpn service start   ->  tarpnctl start        (systemctl start tarpn.target)
#   tarpn service stop    ->  tarpnctl stop
#   tarpn config          ->  tarpnctl config
#   BACKGROUND:ON         ->  systemctl enable tarpn.target

set -euo pipefail

TARPN_PREFIX="${TARPN_PREFIX:-/opt/tarpn}"
. "${TARPN_PREFIX}/lib/tarpn-common.sh"
. "${TARPN_PREFIX}/lib/tarpn-modules.sh"

usage() {
    cat <<'EOF'
tarpnctl - manage a modular TARPN node

Node control
  status                 show node and module state
  start | stop | restart control the whole node (tarpn.target)
  start  <module>        control one module
  stop   <module>
  restart <module>
  enable  [module]       start at boot
  disable [module]       do not start at boot
  logs [module] [-f]     journalctl for the node or one module

  host                   open a terminal into this node from its own console

Diagnostics
  doctor                 check this host can run everything, and say what cannot

Configuration
  config                 edit node.conf, validate, and apply
  check                  validate node.conf without changing anything
  apply                  regenerate bpq32.cfg and restart what needs it
  show                   print the generated bpq32.cfg
  import-node-ini PATH   convert a legacy node.ini into node.conf

Updating
  update                 update the whole node: refresh the source checkout,
                         re-stage /opt/tarpn, reinstall every installed
                         module, regenerate bpq32.cfg, restart what is running
  update <module>...     refresh just these modules (no config regeneration)

Chat
  enable-external-chat-api [--rotate]
                         let clients on other hosts (a bot, a remote app)
                         reach tarpn-chat's client API: binds it past loopback
                         and generates a token they must present. Local
                         clients such as tarpn-mon need no change. Re-run to
                         print the token again; --rotate replaces it
  disable-external-chat-api
                         put the client API back on loopback only

Modules
  list                   list available and installed modules
  install <module>...    install and enable a module
  remove  <module>       remove a module (configuration is kept)

Options
  --dry-run              show what would happen, change nothing
  --no-pull              update without git-pulling the source checkout
  --help                 this message
EOF
}

# ---------------------------------------------------------------------------

UPDATE_PULL=true

ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) TARPN_DRY_RUN=true; shift ;;
        --no-pull) UPDATE_PULL=false; shift ;;
        --help|-h) usage; exit 0 ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

[ $# -gt 0 ] || { usage; exit 1; }

CMD="$1"; shift

need_root() {
    [ "$(id -u)" -eq 0 ] || die "'tarpnctl ${CMD}' needs root (use sudo)"
}

genconfig() {
    "${TARPN_PREFIX}/modules/linbpq/bin/tarpn-bpq-genconfig" "$@"
}

# ---------------------------------------------------------------------------

cmd_status() {
    local unit state

    printf '%sNode%s\n' "$_C_BLU" "$_C_OFF"
    if unit_is_active tarpn.target; then state="running"; else state="stopped"; fi
    printf '  tarpn.target   %s' "$state"
    unit_is_enabled tarpn.target && printf ', enabled at boot' || printf ', not enabled at boot'
    printf '\n'

    if [ -f "$TARPN_NODE_CONF" ]; then
        printf '  callsign       %s (%s)\n' \
            "$(conf_get "$TARPN_NODE_CONF" NODE_CALL '?')" \
            "$(conf_get "$TARPN_NODE_CONF" NODE_NAME '?')"
    elif module_is_installed linbpq; then
        printf '  callsign       %snot configured%s - run: sudo tarpnctl config\n' "$_C_YEL" "$_C_OFF"
    else
        printf '  engine         managed outside this installation\n'
    fi
    printf '  user           %s\n' "$(resolve_tarpn_user)"

    printf '\n%sModules%s\n' "$_C_BLU" "$_C_OFF"
    local name
    for name in $(module_list_available); do
        module_is_installed "$name" || continue
        printf '  %-14s' "$name"
        # hostmode and qtterm own no services - they install a program a person
        # runs. Without this the line just trails off blank, which reads as
        # something being broken.
        if [ -z "$(module_enable_units "$name")" ]; then
            printf ' %sinstalled (no service)%s\n' "$_C_DIM" "$_C_OFF"
            continue
        fi
        for unit in $(module_enable_units "$name"); do
            if unit_is_active "$unit"; then
                printf ' %s%s active%s' "$_C_GRN" "$unit" "$_C_OFF"
            elif unit_is_enabled "$unit"; then
                printf ' %s%s enabled, not running%s' "$_C_YEL" "$unit" "$_C_OFF"
            else
                printf ' %s%s inactive%s' "$_C_DIM" "$unit" "$_C_OFF"
            fi
        done
        printf '\n'
    done
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
# Everything this installation ships is statically linked and OS-version
# agnostic, so the interesting questions are all about the host: is the
# architecture one we build for, is systemd new enough, and - the usual
# answer - is there a linbpq binary that matches the userland.

DOCTOR_FAIL=0
DOCTOR_WARN=0
ok()   { printf '  %s[ ok ]%s %s\n' "$_C_GRN" "$_C_OFF" "$*"; }
warn() { printf '  %s[warn]%s %s\n' "$_C_YEL" "$_C_OFF" "$*"; DOCTOR_WARN=$((DOCTOR_WARN + 1)); }
bad()  { printf '  %s[fail]%s %s\n' "$_C_RED" "$_C_OFF" "$*"; DOCTOR_FAIL=$((DOCTOR_FAIL + 1)); }
hint() { printf '         %s%s%s\n' "$_C_DIM" "$*" "$_C_OFF"; }

# Minimum systemd for the directives the units use. RestrictSUIDSGID (242) is
# the newest of them; Debian 11 already ships 247.
SYSTEMD_MIN=242

cmd_doctor() {
    local v

    printf '%sHost%s\n' "$_C_BLU" "$_C_OFF"
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        ok "$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-$NAME $VERSION_ID}")"
    else
        warn "cannot identify the OS (no /etc/os-release)"
    fi

    local arch bits
    arch="$(detect_arch)"
    bits="$(getconf LONG_BIT 2>/dev/null || echo '?')"
    case "$arch" in
        unknown:*)
            bad "unsupported architecture: ${arch#unknown:}"
            hint "we build for arm32 (armhf), arm64 and amd64" ;;
        *)
            ok "architecture ${arch} (${bits}-bit userland on $(uname -m) kernel)" ;;
    esac

    v="$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}' | tr -cd '0-9')"
    if [ -z "$v" ]; then
        bad "systemd not found"
    elif [ "$v" -ge "$SYSTEMD_MIN" ] 2>/dev/null; then
        ok "systemd ${v} (need ${SYSTEMD_MIN}+)"
    else
        bad "systemd ${v} is too old; the units need ${SYSTEMD_MIN}+"
        hint "RestrictSUIDSGID and ProtectSystem=strict are the newest directives used"
    fi

    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
        ok "bash ${BASH_VERSION%%(*}"
    else
        bad "bash ${BASH_VERSION%%(*} is too old; 4.0+ required"
    fi

    # --- account ----------------------------------------------------------
    printf '\n%sAccount%s\n' "$_C_BLU" "$_C_OFF"
    local user
    user="$(resolve_tarpn_user)"
    if id "$user" >/dev/null 2>&1; then
        ok "TARPN_USER=${user} exists"
        if id -nG "$user" 2>/dev/null | tr ' ' '\n' | grep -qx dialout; then
            ok "${user} is in the dialout group"
        else
            bad "${user} is not in the dialout group; USB TNCs will not be readable"
            hint "sudo usermod -aG dialout ${user}   (then log out and back in)"
        fi
    else
        bad "TARPN_USER=${user} does not exist"
        hint "create it, or set TARPN_USER in ${TARPN_CONF}"
    fi

    # --- node engine ------------------------------------------------------
    printf '\n%sNode engine%s\n' "$_C_BLU" "$_C_OFF"
    local bpq_home binary desc
    bpq_home="$(conf_get "$TARPN_CONF" BPQ_HOME /var/lib/tarpn/bpq)"
    binary="${bpq_home}/linbpq"

    # The linbpq module is optional: this installation is perfectly usable as
    # monitoring bolted onto a node someone else's stack runs. Do not report a
    # missing binary as a fault when we were never asked to manage the engine.
    if ! module_is_installed linbpq; then
        ok "the linbpq module is not installed; the engine is managed elsewhere"
        if [ -n "$(command -v pgrep)" ] && pgrep -x linbpq >/dev/null 2>&1; then
            ok "a linbpq process is running"
        else
            warn "no linbpq process found; monitoring will have nothing to connect to"
        fi
    elif [ ! -f "$binary" ]; then
        bad "no linbpq at ${binary}"
        hint "LinBPQ is third-party and is not redistributed by this installer."
        if desc="$(linbpq_upstream_url "$arch")"; then
            hint "the ${arch} build is at ${desc}"
            hint "sudo tarpnctl update linbpq   will fetch it (LINBPQ_SOURCE=auto)"
        else
            hint "no upstream build is published for ${arch}; supply one and set"
            hint "LINBPQ_SOURCE in ${TARPN_CONF}"
        fi
    else
        if check_linbpq_arch "$binary" "$arch" >/dev/null 2>&1; then
            ok "linbpq present and matches the ${arch} userland"
        else
            check_linbpq_arch "$binary" "$arch" 2>&1 | sed 's/^/  /'
            DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
        fi

        # NETROMPORT, which the tarpn-chat module needs, landed in 6.0.25.
        if command -v strings >/dev/null 2>&1; then
            local ver minor
            ver="$(strings "$binary" 2>/dev/null | grep -oE '6\.0\.[0-9]+\.[0-9]+' | head -1)"
            if [ -n "$ver" ]; then
                minor="$(printf '%s' "$ver" | cut -d. -f3)"
                if [ "$minor" -ge 25 ] 2>/dev/null; then
                    ok "linbpq ${ver} supports NETROMPORT"
                elif module_is_installed tarpn-chat; then
                    bad "linbpq ${ver} has no NETROMPORT, which tarpn-chat needs (6.0.25+)"
                else
                    warn "linbpq ${ver} has no NETROMPORT; the tarpn-chat module needs 6.0.25+"
                fi
            fi
        fi
    fi

    # --- radios -----------------------------------------------------------
    printf '\n%sRadios%s\n' "$_C_BLU" "$_C_OFF"
    local acm
    acm="$(find /dev -maxdepth 1 -name 'ttyACM*' 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$acm" -gt 0 ]; then
        ok "${acm} /dev/ttyACM* device(s) present"
    else
        warn "no /dev/ttyACM* devices; NinoTNC slots A..J will have nothing to talk to"
    fi

    # --- optional features ------------------------------------------------
    printf '\n%sOptional%s\n' "$_C_BLU" "$_C_OFF"
    if command -v sqlite3 >/dev/null 2>&1; then
        ok "sqlite3 $(sqlite3 --version 2>/dev/null | cut -d' ' -f1) (TRR)"
    else
        warn "sqlite3 not installed; the TRR node command cannot run"
        hint "sudo apt install sqlite3 && sudo tarpnctl update node-commands"
    fi

    local lt found=""
    for lt in "$(conf_get "$TARPN_CONF" LINKTEST_BINARY "")" \
              "${TARPN_PREFIX}/modules/node-commands/bin/linktest" \
              /usr/local/sbin/linktest /home/pi/linktest-app; do
        [ -n "$lt" ] && [ -x "$lt" ] && { found="$lt"; break; }
    done
    if [ -n "$found" ]; then
        ok "linktest binary present (LINKTEST)"
    else
        warn "no linktest binary; the LINKTEST node command is unavailable"
        # Do not suggest re-running the installer without checking that there
        # is actually something to fetch - saying "this will install it" when
        # the architecture was never published just wastes the operator's time.
        local lt_url
        if lt_url="$(conf_get "$TARPN_CONF" RELEASE_BASE_URL "https://tarpn-terminal.s3.us-east-1.amazonaws.com")/$(conf_get "$TARPN_CONF" RELEASE_VERSION latest)/linktest.linux-${arch}" \
           && curl -fsI --max-time 10 "$lt_url" >/dev/null 2>&1; then
            hint "sudo tarpnctl update node-commands   will install it"
        else
            hint "not published for ${arch} yet; build it and set LINKTEST_BINARY"
            hint "in ${TARPN_CONF}, then: sudo tarpnctl update node-commands"
        fi
    fi

    # --- configuration ----------------------------------------------------
    printf '\n%sConfiguration%s\n' "$_C_BLU" "$_C_OFF"
    if ! module_is_installed linbpq; then
        # node.conf only drives bpq32.cfg generation, which we are not doing.
        if [ -f "$TARPN_NODE_CONF" ]; then
            ok "node.conf present (unused: the linbpq module is not installed)"
        else
            ok "no node.conf needed without the linbpq module"
        fi
    elif [ ! -f "$TARPN_NODE_CONF" ]; then
        warn "no ${TARPN_NODE_CONF} yet"
        hint "sudo tarpnctl config    (or: sudo tarpnctl import-node-ini /home/pi/node.ini)"
    elif genconfig --check >/dev/null 2>&1; then
        ok "node.conf is valid"
    else
        bad "node.conf has errors"
        hint "run: tarpnctl check"
    fi

    # --- legacy -----------------------------------------------------------
    local legacy=() u
    for u in tarpn.service home.service tarpn_mon.service statusmonitor.service \
             rx_tarpnstat.service neighbor_port_association.service; do
        [ -f "/etc/systemd/system/${u}" ] && legacy+=("$u")
    done
    if [ ${#legacy[@]} -gt 0 ]; then
        printf '\n%sLegacy TARPN%s\n' "$_C_BLU" "$_C_OFF"
        local active=0
        for u in "${legacy[@]}"; do unit_is_active "$u" && active=$((active + 1)); done
        if [ "$active" -gt 0 ]; then
            bad "${active} legacy TARPN service(s) still running"
            hint "both stacks would drive the same radios:"
            hint "sudo systemctl disable --now ${legacy[*]}"
        else
            warn "${#legacy[@]} legacy TARPN unit(s) installed but not running"
        fi
    fi

    # --- node commands: who actually owns the CMDPORTs --------------------
    # LinBPQ connects to these when someone runs TRR or TINFO at the node
    # prompt. The legacy stack registers the same commands in inetd.conf, and
    # inetd is a system service that survives disabling the tarpn* units - so
    # it keeps the ports bound, our sockets fail to bind, and the node answers
    # with the old TRR, whose data source no longer exists ("nan",
    # "MISSING n hours"). Worth naming explicitly, because from the node prompt
    # it looks like a working command returning bad numbers.
    if module_is_installed node-commands; then
        printf '\n%sNode commands%s\n' "$_C_BLU" "$_C_OFF"
        local sock port owner
        for sock in tarpn-cmd-trr tarpn-cmd-tinfo tarpn-cmd-linux tarpn-cmd-linktest; do
            unit_exists "${sock}.socket" || continue
            port="$(sed -n 's/^ListenStream=.*:\([0-9]*\)$/\1/p' \
                    "${TARPN_UNIT_DIR}/${sock}.socket" 2>/dev/null | head -1)"
            if unit_is_active "${sock}.socket"; then
                ok "${sock}.socket listening on ${port:-?}"
                continue
            fi
            owner=""
            if command -v ss >/dev/null 2>&1 && [ -n "$port" ]; then
                owner="$(ss -lntp 2>/dev/null | awk -v p=":${port}\$" '$4 ~ p {print; exit}')"
            fi
            if [ -n "$owner" ]; then
                bad "${sock}.socket is not listening; port ${port} is already taken"
                hint "something else answers this command at the node prompt"
                hint "if it is inetd, comment the legacy entry out of /etc/inetd.conf"
            else
                warn "${sock}.socket is not listening"
                hint "sudo systemctl start ${sock}.socket"
            fi
        done
    fi

    # --- verdict ----------------------------------------------------------
    echo
    if [ "$DOCTOR_FAIL" -gt 0 ]; then
        log_err "${DOCTOR_FAIL} problem(s) will stop this node working, ${DOCTOR_WARN} warning(s)"
        return 1
    elif [ "$DOCTOR_WARN" -gt 0 ]; then
        log_warn "${DOCTOR_WARN} warning(s); the node will run but not everything is available"
    else
        log_info "no problems found"
    fi
}

# The terminal itself belongs to the hostmode module; this is just a familiar
# way to reach it, mirroring the stock `tarpn host`.
cmd_host() {
    local runner="${TARPN_PREFIX}/modules/hostmode/bin/tarpn-host"
    if [ ! -x "$runner" ]; then
        log_err "the hostmode module is not installed"
        log_dim "sudo tarpnctl install hostmode"
        exit 1
    fi
    exec "$runner" "$@"
}

cmd_list() {
    printf '%-14s %-10s %s\n' MODULE STATUS SUMMARY
    local name status
    for name in $(module_list_available); do
        if module_is_installed "$name"; then status="installed"; else status="available"; fi
        printf '%-14s %-10s %s\n' "$name" "$status" "$(module_meta "$name" SUMMARY '')"
    done
}

cmd_lifecycle() {
    local action="$1"; shift
    need_root
    if [ $# -eq 0 ]; then
        run systemctl "$action" tarpn.target
    else
        local n
        for n in "$@"; do module_lifecycle "$action" "$n"; done
    fi
}

cmd_enable() {
    need_root
    if [ $# -eq 0 ]; then
        run systemctl enable tarpn.target
    else
        local n; for n in "$@"; do module_enable "$n"; done
    fi
}

cmd_disable() {
    need_root
    if [ $# -eq 0 ]; then
        run systemctl disable tarpn.target
    else
        local n; for n in "$@"; do module_disable "$n"; done
    fi
}

cmd_logs() {
    local follow=() units=() a
    for a in "$@"; do
        case "$a" in
            -f|--follow) follow=(-f) ;;
            *) units+=("$a") ;;
        esac
    done
    local args=() u
    if [ ${#units[@]} -eq 0 ]; then
        # Everything the node owns, in one stream.
        for u in $(module_list_available); do
            module_is_installed "$u" || continue
            local unit
            for unit in $(module_units "$u"); do
                case "$unit" in *.service) args+=(-u "$unit") ;; esac
            done
        done
    else
        for u in "${units[@]}"; do
            local unit
            for unit in $(module_units "$u"); do
                case "$unit" in *.service) args+=(-u "$unit") ;; esac
            done
        done
    fi
    [ ${#args[@]} -gt 0 ] || die "no services to show logs for"
    exec journalctl "${args[@]}" ${follow[@]+"${follow[@]}"} -n 200
}

cmd_check() {
    genconfig --check
}

cmd_apply() {
    need_root
    log_step "Regenerating bpq32.cfg"
    genconfig

    # Give every installed module a chance to bring its own config back in
    # step with node.conf. On a fresh node the modules are installed before
    # the operator has entered a callsign, so anything derived from it - the
    # chat identity in particular - is a placeholder until this runs.
    local name
    for name in $(module_list_available); do
        module_is_installed "$name" || continue
        module_run_hook "$name" configure || \
            log_warn "module ${name}: configure hook failed"
    done

    # Only restart what actually consumes the config. Monitoring and chat are
    # deliberately not restarted: they reconnect on their own and restarting
    # them would throw away buffered history.
    if unit_is_active tarpn-linbpq.service; then
        log_step "Restarting the node engine to pick up the new config"
        run systemctl restart tarpn-linbpq.service
    else
        log_dim "node engine is not running; the new config applies on next start"
    fi
}

cmd_config() {
    need_root
    if [ ! -f "$TARPN_NODE_CONF" ]; then
        local example="${TARPN_PREFIX}/modules/linbpq/config/node.conf.example"
        [ -f "$example" ] || die "no node.conf and no example to seed it from"
        run install -m 0644 "$example" "$TARPN_NODE_CONF"
        log_info "Created ${TARPN_NODE_CONF}"
    fi

    "${EDITOR:-nano}" "$TARPN_NODE_CONF"

    if genconfig --check; then
        cmd_apply
    else
        log_warn "node.conf still has errors; nothing was applied"
        log_dim "re-run 'sudo tarpnctl config' to fix it"
        exit 1
    fi
}

cmd_show() {
    genconfig --stdout
}

cmd_install() {
    need_root
    [ $# -gt 0 ] || die "usage: tarpnctl install <module>..."
    local name ok="" bad=""
    for name in $(resolve_module_list "$@"); do
        if module_install "$name"; then ok="${ok} ${name}"; else bad="${bad} ${name}"; fi
    done
    systemd_reload
    for name in $ok; do
        module_enable "$name"
    done
    if [ -n "$bad" ]; then
        log_err "not installed:${bad}"
        log_dim "usually means no binary is published for $(detect_arch) yet;"
        log_dim "set <COMPONENT>_SOURCE in ${TARPN_CONF} to a local file and retry"
        return 1
    fi
    log_info "Done. 'tarpnctl status' to review, 'tarpnctl start' to bring the node up."
}

cmd_remove() {
    need_root
    [ $# -gt 0 ] || die "usage: tarpnctl remove <module>"
    local name
    for name in "$@"; do module_remove "$name"; done
}

# Update in two phases. Phase 1 refreshes the source tree and re-stages
# /opt/tarpn; phase 2 does the module, config and restart work. They are
# separated by an exec so that phase 2 runs the code that was just staged
# rather than the code that started the update - otherwise a release that
# changes how modules install would not take effect until the *next* update.
cmd_update() {
    need_root

    if [ "${TARPN_UPDATE_STAGED:-false}" != true ]; then
        cmd_update_stage "$@"
        return
    fi
    cmd_update_apply "$@"
}

# Phase 1: find the source, refresh it, stage it, then hand over.
cmd_update_stage() {
    local src
    src="$(conf_get "$TARPN_CONF" SOURCE_DIR "")"

    if [ -z "$src" ]; then
        # Installed before SOURCE_DIR was recorded, or staged by hand.
        log_err "this node does not record where it was installed from"
        log_dim "run the installer once from your checkout to record it:"
        log_dim "  sudo /path/to/tarpn-mon/tarpn-node/install.sh"
        log_dim "after that, 'sudo tarpnctl update' is enough"
        exit 1
    fi
    [ -d "$src" ] || die "recorded source tree is gone: ${src}"

    if [ "$UPDATE_PULL" != true ]; then
        log_dim "--no-pull given; using ${src} as it is"
    elif ! command -v git >/dev/null 2>&1 || \
         ! git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
        log_dim "${src} is not a git checkout; using it as it is"
    elif [ -n "$(git -C "$src" status --porcelain 2>/dev/null)" ]; then
        # Pulling over local edits either fails or silently discards work.
        log_warn "local changes in ${src}; not pulling"
        log_dim "commit or stash them first, or pass --no-pull to skip this step"
    elif ! git -C "$src" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        log_warn "${src} has no upstream branch; not pulling"
        log_dim "installing from the tree as it is - this may not be the latest"
    else
        log_step "Refreshing ${src}"
        # A failed pull is not fatal: an offline node should still be able to
        # re-stage and repair itself from the checkout it already has. It does
        # mean this is not necessarily the newest code, so say so plainly
        # rather than reporting a clean update.
        if ! run git -C "$src" pull --ff-only; then
            log_warn "git pull failed; installing from the tree as it is"
            log_dim "this may not be the latest - resolve it in ${src} and re-run"
        fi
    fi

    stage_tree "$src"

    if [ "$TARPN_DRY_RUN" = true ]; then
        log_dim "would re-exec the staged tarpnctl to finish the update"
        TARPN_UPDATE_STAGED=true cmd_update_apply "$@"
        return
    fi

    export TARPN_UPDATE_STAGED=true TARPN_DRY_RUN
    exec "${TARPN_PREFIX}/bin/tarpnctl" update "$@"
}

# Phase 2: reinstall modules, refresh the generated config, restart once.
cmd_update_apply() {
    local names=("$@") name
    if [ ${#names[@]} -eq 0 ]; then
        names=()
        for name in $(module_list_available); do
            module_is_installed "$name" && names+=("$name")
        done
    fi
    [ ${#names[@]} -gt 0 ] || die "nothing installed to update"

    local ok=() bad=()
    for name in "${names[@]}"; do
        if module_install "$name"; then ok+=("$name"); else bad+=("$name"); fi
    done
    systemd_reload

    # Regenerate bpq32.cfg and let each module bring its own config back in
    # step. A release often changes the template - that is much of the point of
    # updating - and this is also the pre-flight check for the restart below:
    # tarpn-linbpq.service regenerates the config in ExecStartPre, so a
    # node.conf that does not validate would take the engine down on restart
    # rather than merely failing to update it. Better to find that out here,
    # with the node still running.
    #
    # Skipped when specific modules were named: that is a targeted refresh of
    # those modules, not an update of the node as a whole.
    if [ $# -eq 0 ] && module_is_installed linbpq; then
        log_step "Regenerating bpq32.cfg"
        if ! genconfig; then
            log_err "node.conf does not validate; stopping before anything is restarted"
            log_dim "the node is still running on its previous config"
            log_dim "fix it with 'sudo tarpnctl config', then 'sudo tarpnctl update'"
            exit 1
        fi
        for name in "${ok[@]}"; do
            module_run_hook "$name" configure || \
                log_warn "module ${name}: configure hook failed"
        done
    fi

    # One restart pass at the end, so a unit is restarted once per update
    # rather than once per phase. Only restarts what was already running: a
    # service the operator deliberately stopped stays stopped.
    local unit restarted=""
    for name in "${ok[@]}"; do
        for unit in $(module_enable_units "$name"); do
            if unit_is_active "$unit"; then
                restarted="${restarted} ${unit}"
                unit_restart_if_active "$unit"
            fi
        done
    done
    [ -n "$restarted" ] && log_dim "restarted:${restarted}"

    if [ ${#bad[@]} -gt 0 ]; then
        log_err "not updated: ${bad[*]}"
        log_dim "usually means no binary is published for $(detect_arch) yet"
        exit 1
    fi
    log_info "Updated: ${ok[*]}"
}

cmd_import() {
    need_root
    [ $# -eq 1 ] || die "usage: tarpnctl import-node-ini /path/to/node.ini"
    "${TARPN_PREFIX}/bin/tarpn-import-node-ini" "$1"
}

# ---------------------------------------------------------------------------
# External chat API
#
# tarpn-chat's client API is loopback-only by default. Opening it to other
# hosts needs two things to change together - the bind address and a token -
# and getting them out of step is the dangerous direction: a build without
# token support, or a token that did not reach the process, would serve an
# exposed port that anyone can use to join chat under any callsign and
# transmit from this node. So this does both, checks the result with the
# binary itself before restarting, and puts everything back if it fails.
#
# The token lives in a drop-in of its own rather than override.conf, so
# `systemctl edit tarpn-chat` stays the operator's and neither clobbers the
# other. Drop-ins survive `tarpnctl update`, which only rewrites the unit file
# itself, and tarpn-chat.toml edits survive too: its configure hook only ever
# touches the call and alias lines.
# ---------------------------------------------------------------------------

CHAT_API_DROPIN_DIR="${TARPN_UNIT_DIR}/tarpn-chat.service.d"
CHAT_API_DROPIN="${CHAT_API_DROPIN_DIR}/external-api.conf"
CHAT_API_TOKEN_VAR="TARPN_CHAT_CLIENT_TOKEN"

chat_bin()  { printf '%s/modules/tarpn-chat/bin/tarpn-chat' "$TARPN_PREFIX"; }
chat_conf() { printf '%s/tarpn-chat.toml' "$TARPN_ETC"; }

# A value from the [client] section of tarpn-chat.toml, unquoted.
chat_client_get() {
    awk -v key="$1" '
        /^\[/ { in_client = ($0 ~ /^\[client\][[:space:]]*$/); next }
        in_client && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
            sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]*(#.*)?$/, "")
            gsub(/"/, ""); print; exit
        }' "$(chat_conf)"
}

# Rewrite [client] so bind and token_env are what we say, leaving every other
# line - and every other section - exactly as the operator had it. Appends a
# [client] section if there is none. token_env is set only when $2 is given.
chat_client_set() {
    local bind="$1" token_env="${2-}" conf tmp
    conf="$(chat_conf)"
    tmp="$(mktemp "${conf}.XXXXXX")"
    awk -v bind="$bind" -v tenv="$token_env" '
        # Blank lines inside [client] are held back, so keys added at the end
        # of the section sit with it rather than after the gap before the next.
        function flush() { printf "%s", held; held = "" }
        function finish() {
            if (in_client) {
                if (!did_bind) print "bind = \"" bind "\""
                if (tenv != "") print "token_env = \"" tenv "\""
                in_client = 0
            }
            flush()
        }
        /^\[/ {
            finish()
            if ($0 ~ /^\[client\][[:space:]]*$/) { in_client = 1; seen = 1; did_bind = 0 }
            print; next
        }
        in_client && /^[[:space:]]*bind[[:space:]]*=/ {
            print "bind = \"" bind "\""; did_bind = 1; next
        }
        # Dropped and re-added in finish(), so a re-run never duplicates it
        # and disabling removes it.
        in_client && /^[[:space:]]*token_env[[:space:]]*=/ { next }
        in_client && /^[[:space:]]*$/ { held = held $0 "\n"; next }
        { flush(); print }
        END {
            finish()
            if (!seen) {
                print ""
                print "[client]"
                print "port = 8513"
                print "bind = \"" bind "\""
                if (tenv != "") print "token_env = \"" tenv "\""
            }
        }' "$conf" > "$tmp"

    local user group
    user="$(resolve_tarpn_user)"
    group="$(id -gn "$user" 2>/dev/null || echo "$user")"
    chown "$user:$group" "$tmp" 2>/dev/null || true
    chmod 0644 "$tmp"
    mv "$tmp" "$conf"
}

chat_api_token_from_dropin() {
    [ -f "$CHAT_API_DROPIN" ] || return 0
    sed -n "s/^Environment=${CHAT_API_TOKEN_VAR}=//p" "$CHAT_API_DROPIN" | head -1
}

# 32 random bytes, URL-safe so it can be pasted into a header, an env file or
# a URL without quoting, and free of '%', which systemd would read as a
# specifier in the drop-in.
chat_api_new_token() {
    head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n'
}

cmd_enable_chat_api() {
    need_root
    local rotate=false arg
    for arg in "$@"; do
        case "$arg" in
            --rotate) rotate=true ;;
            *) die "usage: tarpnctl enable-external-chat-api [--rotate]" ;;
        esac
    done

    module_is_installed tarpn-chat || die "the tarpn-chat module is not installed"
    local bin conf
    bin="$(chat_bin)"; conf="$(chat_conf)"
    [ -x "$bin" ]  || die "tarpn-chat binary not found at ${bin}"
    [ -f "$conf" ] || die "${conf} does not exist; run 'sudo tarpnctl apply' first"

    # Refuse on a build that cannot enforce a token. It would accept the
    # config, ignore token_env, and serve the exposed port to anyone.
    local probe
    if ! probe="$("$bin" --check-config --config "$conf" 2>&1)"; then
        if printf '%s' "$probe" | grep -qi "unexpected argument\|unrecognized\|unknown"; then
            log_err "the installed tarpn-chat does not support client API tokens"
            log_dim "update it first: sudo tarpnctl update tarpn-chat"
            log_dim "opening the API on this build would leave it with no authentication"
        else
            log_err "the current tarpn-chat config does not validate:"
            printf '%s\n' "$probe" | sed 's/^/    /' >&2
        fi
        exit 1
    fi

    local token
    token="$(chat_api_token_from_dropin)"
    if [ -n "$token" ] && [ "$rotate" != true ]; then
        log_dim "keeping the existing token (pass --rotate to replace it)"
    else
        token="$(chat_api_new_token)"
        [ -n "$token" ] || die "could not generate a token"
    fi

    local port
    port="$(chat_client_get port)"; port="${port:-8513}"

    if [ "$TARPN_DRY_RUN" = true ]; then
        log_dim "would write ${CHAT_API_DROPIN} with a new token"
        log_dim "would set bind = \"0.0.0.0\" and token_env = \"${CHAT_API_TOKEN_VAR}\" in ${conf}"
        log_dim "would restart tarpn-chat.service if running"
        return 0
    fi

    # Keep the old state, so a failure below leaves the node as it was.
    local conf_backup dropin_backup=""
    conf_backup="$(mktemp)"; cp -p "$conf" "$conf_backup"
    if [ -f "$CHAT_API_DROPIN" ]; then
        dropin_backup="$(mktemp)"; cp -p "$CHAT_API_DROPIN" "$dropin_backup"
    fi
    rollback() {
        log_warn "rolling back"
        cp -p "$conf_backup" "$conf"
        if [ -n "$dropin_backup" ]; then cp -p "$dropin_backup" "$CHAT_API_DROPIN"
        else rm -f "$CHAT_API_DROPIN"; fi
        systemd_reload
    }

    log_step "Writing ${CHAT_API_DROPIN}"
    install -d -m 0755 "$CHAT_API_DROPIN_DIR"
    # 0600: systemd reads drop-ins as root, and nothing else needs the token.
    ( umask 077
      cat > "$CHAT_API_DROPIN" <<EOF
# Written by 'tarpnctl enable-external-chat-api'. Holds the token clients on
# other hosts must present to tarpn-chat's client API. Remove with
# 'tarpnctl disable-external-chat-api', or replace with --rotate.
[Service]
Environment=${CHAT_API_TOKEN_VAR}=${token}
EOF
    )
    chmod 0600 "$CHAT_API_DROPIN"

    log_step "Opening the client API in ${conf}"
    chat_client_set "0.0.0.0" "$CHAT_API_TOKEN_VAR"

    # Validate exactly what the service will run with, before restarting it.
    if ! probe="$(env "${CHAT_API_TOKEN_VAR}=${token}" "$bin" --check-config --config "$conf" 2>&1)" \
       || ! printf '%s' "$probe" | grep -q "token required"; then
        log_err "the new configuration did not validate:"
        printf '%s\n' "$probe" | sed 's/^/    /' >&2
        rollback; exit 1
    fi
    rm -f "$conf_backup" "${dropin_backup:-}"

    systemd_reload
    if unit_is_active tarpn-chat.service; then
        local since
        since="$(date '+%Y-%m-%d %H:%M:%S')"
        unit_restart_if_active tarpn-chat.service
        sleep 2
        if journalctl -u tarpn-chat --since "$since" --no-pager 2>/dev/null \
               | grep -q "Client API listening.*token required"; then
            log_info "tarpn-chat restarted; client API open on port ${port} with a token"
        else
            log_warn "tarpn-chat restarted but did not report a token-protected listener yet"
            log_dim "check: journalctl -u tarpn-chat | grep 'Client API listening'"
        fi
    else
        log_warn "tarpn-chat is not running; it will use this when started"
    fi

    local addrs
    addrs="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^$' | grep -v ':' | head -3 | tr '\n' ' ')"
    cat <<EOF

Clients on other hosts must send:  Authorization: Bearer <token>
Local clients (tarpn-mon) need nothing.

  token:    ${token}
  address:  $(hostname):${port}${addrs:+   (or ${addrs% })}

For the chat bot, in /etc/tarpn-chatbot/tarpn-chatbot.env:

  TARPN_CHAT_ADDR=$(hostname):${port}
  ${CHAT_API_TOKEN_VAR}=${token}

Treat the token like a password: anything holding it can join chat from this
node under any callsign. Print it again by re-running this command; replace it
with --rotate, which disconnects clients still using the old one.
EOF
}

cmd_disable_chat_api() {
    need_root
    module_is_installed tarpn-chat || die "the tarpn-chat module is not installed"
    local conf
    conf="$(chat_conf)"

    if [ "$TARPN_DRY_RUN" = true ]; then
        log_dim "would set bind = \"127.0.0.1\" and remove token_env in ${conf}"
        log_dim "would remove ${CHAT_API_DROPIN} and restart tarpn-chat.service if running"
        return 0
    fi

    # Loopback first, then the token: in that order there is never a moment
    # with the port exposed and no token behind it.
    [ -f "$conf" ] && chat_client_set "127.0.0.1"
    rm -f "$CHAT_API_DROPIN"
    rmdir "$CHAT_API_DROPIN_DIR" 2>/dev/null || true
    systemd_reload
    unit_restart_if_active tarpn-chat.service
    log_info "client API back on loopback only; token removed"
}

# ---------------------------------------------------------------------------

case "$CMD" in
    status)          cmd_status ;;
    doctor)          cmd_doctor ;;
    host)            cmd_host ;;
    list)            cmd_list ;;
    start|stop|restart) cmd_lifecycle "$CMD" "$@" ;;
    enable)          cmd_enable "$@" ;;
    disable)         cmd_disable "$@" ;;
    logs)            cmd_logs "$@" ;;
    check)           cmd_check ;;
    apply)           cmd_apply ;;
    config)          cmd_config ;;
    show)            cmd_show ;;
    install)         cmd_install "$@" ;;
    remove)          cmd_remove "$@" ;;
    update)          cmd_update "$@" ;;
    import-node-ini) cmd_import "$@" ;;
    enable-external-chat-api)  cmd_enable_chat_api "$@" ;;
    disable-external-chat-api) cmd_disable_chat_api "$@" ;;
    help)            usage ;;
    *)               log_err "unknown command: ${CMD}"; usage; exit 1 ;;
esac
