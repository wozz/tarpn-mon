#!/bin/bash
# routes/postinstall - install the send-routes-via-cq binary.
set -euo pipefail

mod="$(module_dir routes)"
run install -d -m 0755 "${mod}/bin"

install_release_binary send-routes-via-cq "${mod}/bin/send-routes-via-cq"

# The legacy stack calls sendroutestocq from inside statusmonitor.sh's polling
# loop. If those scripts are still on the box, both will broadcast and the
# node will transmit duplicate TARPNstat frames.
if [ -x /usr/local/sbin/sendroutestocq ] && [ -f /usr/local/sbin/statusmonitor.sh ]; then
    if ! grep -q '^[[:space:]]*#.*sendroutestocq' /usr/local/sbin/statusmonitor.sh 2>/dev/null; then
        log_warn "the legacy statusmonitor.sh still calls sendroutestocq"
        log_dim "leaving it alone - this installer does not edit legacy TARPN scripts"
        log_dim "to avoid duplicate broadcasts, stop the legacy stack:"
        log_dim "  sudo systemctl disable --now statusmonitor.service"
    fi
fi
