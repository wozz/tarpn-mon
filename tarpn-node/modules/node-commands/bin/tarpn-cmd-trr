#!/bin/bash
# TRR - link quality per neighbour, both directions.
#
# This is a reimplementation, not a port. The legacy TRR (w4eip_link_quality,
# a perl script) read two files that this installation does not produce:
#
#   /usr/local/etc/tarpn_home_linkquality.dat   written by rx_tarpnstatapp
#   /tmp/tarpn/tnpa/npa_port_*                  written by the NPA app
#
# Both of those are closed-source 32-bit binaries.
#
# tarpn-mon sees the very same [TARPNstat V2] broadcasts on the monitor stream
# that rx_tarpnstatapp did, and records them in link_stats_tarpnstat. That
# table keeps the monitor's R/T direction flag, so our own outgoing broadcast
# and the neighbour's incoming one can be paired per port - which is exactly
# the bilateral view the legacy linkquality file provided.
#
# This deliberately does NOT use link_stats_raw or link_stats_neighbor:
#
#   link_stats_raw       per-port L2 counters from LinBPQ's S command
#   link_stats_neighbor  the same L2 counters carried in a neighbour's [LS1]
#                        broadcast, which only nodes running this software emit
#
# Those are a different layer from TARPNstat's route-level tx/ret/buf, and the
# [LS1] table is empty for every stock TARPN neighbour on the network.
#
# The output matches TARPN's current TRR (trr.app, from trr5.zip), read out of
# the unstripped binary rather than guessed:
#
#   "TRR v%u", "  Results are in sets of 3: recent, hour, and longest"
#   "port call  |    Tx Rate    |  Tx Retries  |    Rx Rate    |  Rx Retries"
#   row     "%u %9s|", rates " %4.1f", retries "%3u%%" or "----"
#   staleness " MISSING %u days" / " MISSING %u hours" / " MISSING for %um"
#
# and its three windows, from the debug strings "sum-of-last-1",
# "sum-of-last-4" and "sum-of-last-%u":
#
#   recent   the last two broadcasts
#   hour     the last five, which at the 15 minute broadcast interval is an hour
#   longest  every retained broadcast, as trr.app takes `tail -100` of the file
#
# Rate is frames per hour: trr.app multiplies delta/seconds by a literal
# 3600.0. Its "nan" is that division with a zero time span - printed here as
# "nan" too, since a blank would read as zero traffic rather than no data.
#
# NOTE: the figures are cumulative counters as last broadcast, and they reset
# when a node restarts. A negative delta means a restart inside the window and
# is reported as no data rather than as a nonsense rate.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_cmd-common.sh"

DB="$(conf_get "$TARPN_CONF" LINK_STATS_DB "${TARPN_STATE}/mon/linkstats.db")"

if ! command -v sqlite3 >/dev/null 2>&1; then
    say "TRR is not available: sqlite3 is not installed on this node."
    exit 0
fi

if [ ! -r "$DB" ]; then
    say "TRR has no data yet."
    say "(needs the tarpn-mon module running to collect TARPNstat)"
    exit 0
fi

# Version reported in the banner. Not TARPN's - theirs counts their releases,
# and claiming one of their numbers would misattribute any difference.
TRR_VERSION=1

# 15 minutes, the interval send-routes-via-cq broadcasts on, so five samples
# span an hour the way trr.app's "sum-of-last-4" does.
WINDOW_HOUR=5
WINDOW_MAX=100

say "TRR v${TRR_VERSION}  Results are in sets of 3: recent, hour, and longest"
say "port call  |    Tx Rate    |  Tx Retries  |    Rx Rate    |  Rx Retries"

# Newest first, capped like trr.app's tail -100. Read-only so this can never
# block tarpn-mon writing the same file.
rows="$(sqlite3 -readonly -separator '|' "$DB" "
SELECT port_num, direction, CAST(strftime('%s', timestamp) AS INTEGER), callsign, tx, ret
FROM (
    SELECT s.*, ROW_NUMBER() OVER (
               PARTITION BY port_num, direction ORDER BY timestamp DESC) AS rn
    FROM link_stats_tarpnstat s
)
WHERE rn <= ${WINDOW_MAX}
ORDER BY port_num, direction, rn;
" 2>/dev/null || true)"

if [ -z "$rows" ]; then
    say "No TARPNstat broadcasts recorded yet."
    say "(they are sent every 15 minutes; allow a cycle after a restart)"
    exit 0
fi

printf '%s\n' "$rows" | awk -F'|' -v now="$(date +%s)" -v hourw="$WINDOW_HOUR" '
# Collect per port and direction, already newest-first.
{
    p = $1; d = $2
    n[p,d]++
    i = n[p,d]
    t[p,d,i] = $3; tx[p,d,i] = $5; rt[p,d,i] = $6
    if (i == 1) { call[p] = $4; if (d == "R") lastR[p] = $3 }
    seen[p] = 1
}

# rate over the window ending at the newest sample and starting at index j,
# in frames per hour. Returns "nan" when the span is zero, as trr.app does,
# and when a counter has gone backwards - a node restarted mid-window.
function rate(p, d, j,   dt, dtx, v) {
    if (n[p,d] < j) return " nan"
    dt  = t[p,d,1]  - t[p,d,j]
    dtx = tx[p,d,1] - tx[p,d,j]
    if (dt <= 0 || dtx < 0) return " nan"
    v = (dtx / dt) * 3600
    # Every field is exactly four characters or the columns shear. trr.app
    # carries both " %4.1f" and " %4.0f" for the same reason: one decimal
    # place stops fitting at 100.
    if (v >= 100) return sprintf("%4.0f", v)
    return sprintf("%4.1f", v)
}

# retries as a percentage of frames sent over the same window. "----" when
# there is nothing to divide by, which is trr.app s placeholder.
function retry(p, d, j,   dtx, drt) {
    if (n[p,d] < j) return "----"
    dtx = tx[p,d,1] - tx[p,d,j]
    drt = rt[p,d,1] - rt[p,d,j]
    if (dtx <= 0 || drt < 0) return "----"
    return sprintf("%3u%%", (drt * 100) / dtx)
}

# How long since the neighbour was last heard. trr.app reports this whenever
# it has a gap, in whichever unit reads best.
function missing(p,   age) {
    if (!(p in lastR)) return " MISSING"
    age = now - lastR[p]
    if (age < 1800)  return ""
    if (age < 86400) return sprintf(" MISSING %u hours", int(age / 3600))
    return sprintf(" MISSING %u days", int(age / 86400))
}

END {
    # Ports are small integers, so walk the range rather than sorting the keys:
    # asorti is a gawk extension and Raspberry Pi OS ships mawk.
    for (p = 1; p <= 32; p++) {
        if (!(p in seen)) continue
        last = (n[p,"T"] > n[p,"R"] ? n[p,"T"] : n[p,"R"])
        printf "%u %9s| %s %s %s|%s %s %s| %s %s %s|%s %s %s|%s\n", p, call[p],
            rate(p,"T",2), rate(p,"T",hourw), rate(p,"T",last),
            retry(p,"T",2), retry(p,"T",hourw), retry(p,"T",last),
            rate(p,"R",2), rate(p,"R",hourw), rate(p,"R",last),
            retry(p,"R",2), retry(p,"R",hourw), retry(p,"R",last),
            missing(p)
    }
}' | while IFS= read -r line; do say "$line"; done

blank
say "Tx is this node, Rx is the neighbour, each from its own broadcast,"
say "so a link good one way and bad the other is asymmetric."
exit 0
