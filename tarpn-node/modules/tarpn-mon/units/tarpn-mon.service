[Unit]
Description=TARPN monitor and web interface
Documentation=https://github.com/wozz/tarpn-mon

PartOf=tarpn.target

# Ordering only - deliberately NOT Requires= or BindsTo=. The legacy
# tarpnmon-runner.sh killed the monitor whenever linbpq stopped, which threw
# away the packet buffer. This service maintains its own connection, shows
# "disconnected" while the engine is down, and reconnects on its own.
After=tarpn-linbpq.service
After=network.target

[Service]
Type=simple
User=@TARPN_USER@
Group=@TARPN_GROUP@

# linkstats.db, chat.db and tarpn-mon.json are all written relative to the
# working directory.
WorkingDirectory=@TARPN_STATE@/mon
ExecStart=@TARPN_PREFIX@/modules/tarpn-mon/bin/tarpn-mon-launch

# Operator overrides for the launcher. Optional.
EnvironmentFile=-@TARPN_ETC@/tarpn-mon.env

Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
ReadWritePaths=@TARPN_STATE@/mon

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tarpn-mon

[Install]
WantedBy=tarpn.target
