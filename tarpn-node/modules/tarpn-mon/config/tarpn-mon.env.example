# /etc/tarpn/tarpn-mon.env - optional overrides for the tarpn-mon service.
#
# Everything here has a working default derived from node.conf. You only need
# this file to deviate from it. Run `sudo systemctl restart tarpn-mon` after
# editing.
#
# NOTE: the chat, BBS and node console feature toggles are NOT set here. They
# live in tarpn-mon.json in the service's working directory and are edited
# through the web UI, which writes them back. Setting them here would undo
# your UI changes on every restart.

# Callsign used to log in to the node's telnet port. Defaults to OP_CALL from
# node.conf, which is what the generated bpq32.cfg defines as the SYSOP user.
#TARPN_MON_CALL=N0CALL

# Telnet password. The generated bpq32.cfg uses "p".
#TARPN_MON_PASSWORD=p

# Where the node engine is. Only change these if the engine is not local or
# has been configured with non-default ports.
#TARPN_MON_HOST=localhost
#TARPN_MON_MONITOR_PORT=8011

# L2 link statistics collection, polled from LinBPQ's S command. Polling is
# local only - it reads the node over telnet and puts nothing on the air.
#TARPN_MON_STATS=true
#TARPN_MON_STATS_INTERVAL=60

# Stats collection has two side effects that DO transmit. Both are on by
# default; turn either off to collect statistics without adding traffic.
#
# [LS1] link-stats CQ broadcast, sent on every RF port every 10 minutes. This
# is what lets neighbours running tarpn-mon show both ends of a link. Note it
# is separate from, and additional to, the [TARPNstat V2] broadcast that the
# `routes` module (or the legacy sendroutestocq) sends every 15 minutes.
#TARPN_MON_STATS_CQ=true
#
# Daily BBS bulletin, posted as "SB STATS @" shortly after midnight. Whether
# it travels beyond the local BBS depends on that BBS's forwarding rules -
# TARPN setups generally forward only specific @<tag> designators, so a bare
# @ normally stays put. Check your own forwarding config if that matters.
#TARPN_MON_STATS_BULLETIN=true

# Verbose logging: journalctl -u tarpn-mon -f
#TARPN_MON_DEBUG=false

# Passed through to the binary verbatim, for anything not covered above.
#TARPN_MON_EXTRA_ARGS=-ports 12

# The web interface listens on port 8212. That is currently compiled in
# rather than configurable; put a reverse proxy in front of it if you need a
# different port.
