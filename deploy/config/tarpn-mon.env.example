# tarpn-mon configuration
#
# This file contains environment variables for the tarpn-mon service.
# Copy to /opt/tarpn-mon/tarpn-mon.env and edit as needed.
# Restart the service after changes: sudo systemctl restart tarpn-mon

# =============================================================================
# Required Settings
# =============================================================================

# Your callsign (used for display and chat features)
TARPN_MON_CALL=N0CALL

# =============================================================================
# LinBPQ Connection (usually no changes needed)
# =============================================================================

# LinBPQ telnet host
# TARPN_MON_HOST=localhost

# LinBPQ telnet port (for BBS/Node/Chat commands)
# TARPN_MON_BPQ_PORT=8010

# LinBPQ monitor port (for packet monitoring)
# TARPN_MON_MONITOR_PORT=8011

# =============================================================================
# Web Interface
# =============================================================================

# Port for the web interface
# TARPN_MON_PORT=8212

# =============================================================================
# Chat Configuration
# =============================================================================

# When using WebSocket mode to connect to tarpn-chat:
# TARPN_MON_CHAT_WS_MODE=true
# TARPN_MON_CHAT_HOST=localhost
# TARPN_MON_CHAT_PORT=8513

# When using telnet mode to connect to LinBPQ chat:
# TARPN_MON_CHAT_WS_MODE=false
# TARPN_MON_CHAT_HOST=localhost
# TARPN_MON_CHAT_PORT=8010
